# EnthusiaStaff Staff Bot runtime configuration example.
# PLACEHOLDERS ONLY. Never commit or paste real token/database/HMAC values.

# Required for every normal launch.
ENTHUSIA_STAFF_BOT_ENVIRONMENT=staging
ENTHUSIA_STAFF_BOT_TOKEN=<runtime-secret>

# Optional process/health tuning. Health is loopback-only.
ENTHUSIA_STAFF_BOT_HEALTH_HOST=127.0.0.1
ENTHUSIA_STAFF_BOT_HEALTH_PORT=8765
ENTHUSIA_STAFF_BOT_WORKER_THREADS=4
ENTHUSIA_STAFF_BOT_WORKER_QUEUE_CAPACITY=256
ENTHUSIA_STAFF_BOT_INTERACTION_CAPACITY=4096
ENTHUSIA_STAFF_BOT_INTERACTION_TTL_SECONDS=900

# DiscordSRV chat migration only. Keep false until the Velocity STAFFBOT peer is staged.
# This feature is rejected when ENTHUSIA_STAFF_BOT_ENVIRONMENT=production.
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_ENABLED=false
# Set the following only when ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_ENABLED=true:
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_HOST=<velocity-tls-hostname>
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_PORT=28765
# Base64-encoded HMAC-SHA256 key with at least 32 random bytes for the STAFFBOT peer.
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_CLIENT_SECRET=<base64-runtime-secret>
# Base64-encoded HMAC-SHA256 key matching Velocity's configured proxy signing key.
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_PROXY_SECRET=<base64-runtime-secret>
# Trust store containing the Velocity channel server certificate/CA.
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_TRUST_STORE=<absolute-or-runtime-path-to-truststore>
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_TRUST_STORE_PASSWORD=<runtime-secret>
# Explicit allowlist. During this checkpoint every destination must be the fixed staging test channel.
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_ROUTES=SMP/global=1541286004298752091;HUB/global=1541286004298752091
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_QUEUE_CAPACITY=256
# ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_DEDUPE_CAPACITY=4096

# Required as one complete group to enable the Staff/MariaDB read integration.
ENTHUSIA_STAFF_BOT_DB_JDBC_URL=jdbc:mariadb://<private-db-host>:3306/<database>
ENTHUSIA_STAFF_BOT_DB_USERNAME=<runtime-user>
ENTHUSIA_STAFF_BOT_DB_PASSWORD=<runtime-secret>
ENTHUSIA_STAFF_BOT_AUTHORITY_URL=http://<private-paper-host>:8771/v1/staff-rank
ENTHUSIA_STAFF_BOT_AUTHORITY_TRANSPORT=bloom-private-split
ENTHUSIA_STAFF_DISCORD_AUTHORITY_SECRET=<runtime-secret-at-least-32-chars>
ENTHUSIA_STAFF_BOT_COMPONENT_SECRET=<different-runtime-secret-at-least-32-chars>

# Optional DB tuning.
ENTHUSIA_STAFF_BOT_DB_POOL_SIZE=4
ENTHUSIA_STAFF_BOT_DB_TIMEOUT_MILLIS=3000

# DiscordSRV migration only: read-only parity for provider-neutral managed-role claims.
# Requires the Discord application's privileged Server Members Intent. It never mutates roles.
ENTHUSIA_STAFF_BOT_MANAGED_ROLE_SHADOW_ENABLED=false
# Set these only when ENTHUSIA_STAFF_BOT_MANAGED_ROLE_SHADOW_ENABLED=true:
# ENTHUSIA_STAFF_BOT_MANAGED_ROLE_SHADOW_INTERVAL_SECONDS=300
# ENTHUSIA_STAFF_BOT_MANAGED_ROLE_SHADOW_MAX_CLAIMS=2000

# Explicit production action gate. Keep false in staging; production may set true only with the complete enforcement policy below.
ENTHUSIA_STAFF_BOT_DISCORD_ENFORCEMENT_ENABLED=false
ENTHUSIA_STAFF_BOT_DISCORD_MUTE_ROLE_ID=<discord-role-id>
ENTHUSIA_STAFF_BOT_DISCORD_SUPPORT_SCOPE_IDS=<comma-separated-channel-or-category-ids>
ENTHUSIA_STAFF_BOT_DISCORD_SUPPORT_MESSAGE=<short-support-guidance>
ENTHUSIA_STAFF_BOT_DISCORD_HELPER_MAX_MUTE_SECONDS=<approved-seconds>
ENTHUSIA_STAFF_BOT_DISCORD_MOD_MAX_MUTE_SECONDS=<approved-seconds>
ENTHUSIA_STAFF_BOT_DISCORD_MOD_MAX_BAN_SECONDS=<approved-seconds>
ENTHUSIA_STAFF_BOT_DISCORD_MOD_MAX_RESTRICTION_SECONDS=<approved-seconds>
